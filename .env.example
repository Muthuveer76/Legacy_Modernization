# Copy to .env for local development. In production, set these on your host.

NODE_ENV=development
PORT=5000

# MongoDB Atlas (cloud) connection string: Atlas → your cluster → Connect → Drivers.
# Replace <username>/<password> with a database user (Atlas → Database Access), URL-encode
# special characters in the password, and allow your IP in Atlas → Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/legacy_modernization?retryWrites=true&w=majority&appName=LegacyLift
# Database used when the connection string names none
MONGODB_DB=legacy_modernization
# Local alternative (run `npm run dev:db` first):
# MONGODB_URI=mongodb://127.0.0.1:27017/legacy_modernization

# Required in production: a long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables the AI code generation engine (Claude). Without it the
# platform uses its rule-based structural translator for the Generate stage.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
# Server-side refusal fallback (on by default); set to "off" if your model or platform rejects it
ANTHROPIC_FALLBACKS=default

# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, Nginx)
TRUST_PROXY=0

# Limits
MAX_PROJECT_KB=2048
MAX_FILE_KB=200
MAX_FILES_PER_PROJECT=25
MAX_AI_SOURCE_LINES=3000
MAX_CONCURRENT_JOBS_PER_USER=2
